<?xml version="1.0" encoding="utf-8"?>
<!-- Instagram-style sponsored post: header, big media, CTA bar, caption. -->
<com.google.android.gms.ads.nativead.NativeAdView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header (right padding leaves room for the AdChoices icon) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="48dp"
            android:paddingBottom="10dp">

            <ImageView
                android:id="@+id/twice_ad_icon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/twice_ad_icon_bg"
                android:contentDescription="@null"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/twice_ad_headline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/twice_ad_sponsored"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Sponsored"
                        android:textColor="#A8A8A8"
                        android:textSize="12sp" />

                    <!-- Mandatory ad label (Google policy) -->
                    <TextView
                        android:id="@+id/twice_ad_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/twice_ad_badge_bg"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:text="Ad"
                        android:textColor="#A8A8A8"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Media: photo or auto-playing video. Takes all remaining height. -->
        <com.google.android.gms.ads.nativead.MediaView
            android:id="@+id/twice_ad_media"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#000000" />

        <!-- Call to action bar -->
        <Button
            android:id="@+id/twice_ad_cta"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/twice_ad_cta_bg"
            android:stateListAnimator="@null"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Caption -->
        <TextView
            android:id="@+id/twice_ad_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />
    </LinearLayout>
</com.google.android.gms.ads.nativead.NativeAdView>
