import 'dart:ffi' hide Size;

import 'package:flutter/material.dart';
import 'package:photo_manager/photo_manager.dart';

const ink = Color(0xFF171923);
const muted = Color(0xFF7B8191);
const violet = Color(0xFF7257F5);
const canvas = Color(0xFFF7F7FB);

void main() {
  runApp(const TwiceApp());
}

class NativeCore {
  NativeCore._() {
    try {
      final lib = DynamicLibrary.open('libtwice_native.so');
      _add = lib
          .lookupFunction<Int32 Function(Int32, Int32), int Function(int, int)>(
            'twice_native_add',
          );
    } catch (_) {
      // Keeps Flutter tests and non-Android preview environments usable.
      _add = null;
    }
  }

  static final NativeCore instance = NativeCore._();

  late final int Function(int, int)? _add;

  int add(int a, int b) => _add?.call(a, b) ?? a + b;

  bool get isLoaded => _add != null;
}

class TwiceApp extends StatelessWidget {
  const TwiceApp({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      title: 'Twice',
      debugShowCheckedModeBanner: false,
      theme: ThemeData(
        useMaterial3: true,
        scaffoldBackgroundColor: canvas,
        colorScheme: ColorScheme.fromSeed(
          seedColor: violet,
          brightness: Brightness.light,
        ),
        fontFamily: 'Roboto',
        appBarTheme: const AppBarTheme(
          backgroundColor: canvas,
          foregroundColor: ink,
          elevation: 0,
          centerTitle: false,
        ),
      ),
      home: const TwiceShell(),
    );
  }
}

class SocialPost {
  SocialPost({
    required this.id,
    required this.name,
    required this.handle,
    required this.initials,
    required this.avatar,
    required this.art,
    required this.caption,
    required this.likes,
    this.liked = false,
    this.media = const [],
  });

  final int id;
  final String name;
  final String handle;
  final String initials;
  final Color avatar;
  final List<Color> art;
  final String caption;
  int likes;
  bool liked;
  final List<AssetEntity> media;
}

class TwiceShell extends StatefulWidget {
  const TwiceShell({super.key});

  @override
  State<TwiceShell> createState() => _TwiceShellState();
}

class _TwiceShellState extends State<TwiceShell> {
  int selected = 0;
  int nextId = 10;

  final List<SocialPost> posts = [
    SocialPost(
      id: 1,
      name: 'Sofia Bennett',
      handle: '@sofia.b',
      initials: 'SB',
      avatar: const Color(0xFFF0B8A6),
      art: const [Color(0xFFF9C6B4), Color(0xFFE9A2C1)],
      caption:
          'Collect moments, not things. A little sunshine goes a long way ☀️',
      likes: 248,
    ),
    SocialPost(
      id: 2,
      name: 'Marcus Lee',
      handle: '@marcuslee',
      initials: 'ML',
      avatar: const Color(0xFFB8C8F4),
      art: const [Color(0xFF91C9C2), Color(0xFF6E8CD5)],
      caption: 'Slow mornings, good coffee, and absolutely nowhere to rush. ☕',
      likes: 182,
    ),
    SocialPost(
      id: 3,
      name: 'Ava Morgan',
      handle: '@avamorgan',
      initials: 'AM',
      avatar: const Color(0xFFE6C9F2),
      art: const [Color(0xFFB6A0E8), Color(0xFFEDB6D1)],
      caption: 'Make room for the little things that make you happy.',
      likes: 96,
    ),
  ];

  void toggleLike(SocialPost post) {
    setState(() {
      post.liked = !post.liked;
      post.likes += post.liked ? 1 : -1;
    });
  }

  void createPost(String caption, [List<AssetEntity> media = const []]) {
    setState(() {
      posts.insert(
        0,
        SocialPost(
          id: nextId++,
          name: 'Your Profile',
          handle: '@you',
          initials: 'Y',
          avatar: violet,
          art: const [Color(0xFFB8A8FF), Color(0xFFEDC0DE)],
          caption: caption,
          likes: 0,
          media: List<AssetEntity>.unmodifiable(media),
        ),
      );
      selected = 0;
    });

    ScaffoldMessenger.of(context).showSnackBar(
      const SnackBar(content: Text('Demo post added to your feed')),
    );
  }

  @override
  Widget build(BuildContext context) {
    final screens = <Widget>[
      FeedPage(posts: posts, onLike: toggleLike),
      SearchPage(posts: posts),
      CreatePage(onPost: createPost),
      const ActivityPage(),
      ProfilePage(posts: posts),
    ];

    return Scaffold(
      appBar: AppBar(
        title: const Text(
          'Twice',
          style: TextStyle(fontWeight: FontWeight.w900, fontSize: 28),
        ),
        actions: [
          IconButton(
            tooltip: 'Messages',
            onPressed: () {
              ScaffoldMessenger.of(context).showSnackBar(
                const SnackBar(content: Text('Messaging will be added later')),
              );
            },
            icon: const Icon(Icons.send_outlined),
          ),
          const SizedBox(width: 8),
        ],
      ),
      body: IndexedStack(index: selected, children: screens),
      bottomNavigationBar: NavigationBar(
        selectedIndex: selected,
        backgroundColor: Colors.white,
        indicatorColor: const Color(0xFFECE7FF),
        onDestinationSelected: (value) => setState(() => selected = value),
        destinations: const [
          NavigationDestination(
            icon: Icon(Icons.home_outlined),
            selectedIcon: Icon(Icons.home_rounded),
            label: 'Home',
          ),
          NavigationDestination(
            icon: Icon(Icons.search_rounded),
            label: 'Explore',
          ),
          NavigationDestination(
            icon: Icon(Icons.add_box_outlined),
            selectedIcon: Icon(Icons.add_box_rounded),
            label: 'Create',
          ),
          NavigationDestination(
            icon: Icon(Icons.favorite_border_rounded),
            selectedIcon: Icon(Icons.favorite_rounded),
            label: 'Activity',
          ),
          NavigationDestination(
            icon: Icon(Icons.person_outline_rounded),
            selectedIcon: Icon(Icons.person_rounded),
            label: 'Profile',
          ),
        ],
      ),
    );
  }
}

class FeedPage extends StatelessWidget {
  const FeedPage({super.key, required this.posts, required this.onLike});

  final List<SocialPost> posts;
  final ValueChanged<SocialPost> onLike;

  @override
  Widget build(BuildContext context) {
    return ListView(
      padding: const EdgeInsets.fromLTRB(0, 4, 0, 24),
      children: [
        const Padding(
          padding: EdgeInsets.symmetric(horizontal: 16),
          child: StoryStrip(),
        ),
        const SizedBox(height: 8),
        ...posts.map((post) => PostCard(post: post, onLike: onLike)),
        const SizedBox(height: 16),
        const Center(
          child: Text('You’re all caught up ✨', style: TextStyle(color: muted)),
        ),
      ],
    );
  }
}

class StoryStrip extends StatelessWidget {
  const StoryStrip({super.key});

  @override
  Widget build(BuildContext context) {
    const names = ['Your story', 'Sofia', 'Marcus', 'Ava', 'Noah', 'Mia'];
    const colors = [
      violet,
      Color(0xFFF0B8A6),
      Color(0xFFB8C8F4),
      Color(0xFFE6C9F2),
      Color(0xFFB4DFCD),
      Color(0xFFF0D18D),
    ];

    return SizedBox(
      height: 105,
      child: ListView.separated(
        scrollDirection: Axis.horizontal,
        itemCount: names.length,
        separatorBuilder: (_, _) => const SizedBox(width: 15),
        itemBuilder: (context, i) => SizedBox(
          width: 61,
          child: Column(
            children: [
              Container(
                padding: const EdgeInsets.all(3),
                decoration: BoxDecoration(
                  shape: BoxShape.circle,
                  border: Border.all(
                    color: i == 0 ? const Color(0xFFD9D5E5) : violet,
                    width: 1.7,
                  ),
                ),
                child: CircleAvatar(
                  radius: 25,
                  backgroundColor: colors[i],
                  child: i == 0
                      ? const Icon(Icons.add, color: Colors.white, size: 28)
                      : Text(
                          names[i][0],
                          style: const TextStyle(
                            fontWeight: FontWeight.w800,
                            color: ink,
                          ),
                        ),
                ),
              ),
              const SizedBox(height: 6),
              Text(
                names[i],
                maxLines: 1,
                overflow: TextOverflow.ellipsis,
                style: const TextStyle(fontSize: 11, color: ink),
              ),
            ],
          ),
        ),
      ),
    );
  }
}

class _RepostActionButton extends StatefulWidget {
  const _RepostActionButton({required this.onPressed});

  final VoidCallback onPressed;

  @override
  State<_RepostActionButton> createState() => _RepostActionButtonState();
}

class _RepostActionButtonState extends State<_RepostActionButton>
    with SingleTickerProviderStateMixin {
  late final AnimationController _controller = AnimationController(
    vsync: this,
    duration: const Duration(milliseconds: 650),
  );

  @override
  void dispose() {
    _controller.dispose();
    super.dispose();
  }

  void _repost() {
    _controller.forward(from: 0);
    widget.onPressed();
  }

  @override
  Widget build(BuildContext context) {
    return IconButton(
      tooltip: 'Repost',
      onPressed: _repost,
      icon: AnimatedBuilder(
        animation: _controller,
        builder: (context, child) {
          final t = _controller.value;
          return Transform.rotate(
            angle: t * 2 * 3.141592653589793,
            child: Transform.translate(
              offset: Offset(0, -3 * (1 - (2 * t - 1).abs())),
              child: child,
            ),
          );
        },
        child: const Icon(Icons.repeat_rounded, size: 28),
      ),
    );
  }
}

class _AnimatedLikeButton extends StatefulWidget {
  const _AnimatedLikeButton({required this.liked, required this.onPressed});

  final bool liked;
  final VoidCallback onPressed;

  @override
  State<_AnimatedLikeButton> createState() => _AnimatedLikeButtonState();
}

class _AnimatedLikeButtonState extends State<_AnimatedLikeButton>
    with SingleTickerProviderStateMixin {
  late final AnimationController _controller = AnimationController(
    vsync: this,
    duration: const Duration(milliseconds: 500),
  );

  late final Animation<double> _pop = TweenSequence<double>([
    TweenSequenceItem(
      tween: Tween(
        begin: 1.0,
        end: 1.42,
      ).chain(CurveTween(curve: Curves.easeOutBack)),
      weight: 22,
    ),
    TweenSequenceItem(
      tween: Tween(
        begin: 1.42,
        end: 1.0,
      ).chain(CurveTween(curve: Curves.easeInOut)),
      weight: 18,
    ),
    TweenSequenceItem(tween: Tween(begin: 1.0, end: 1.0), weight: 60),
  ]).animate(_controller);

  @override
  void didUpdateWidget(covariant _AnimatedLikeButton oldWidget) {
    super.didUpdateWidget(oldWidget);
    if (oldWidget.liked != widget.liked) {
      _controller.forward(from: 0);
    }
  }

  @override
  void dispose() {
    _controller.dispose();
    super.dispose();
  }

  void _like() {
    widget.onPressed();
    _controller.forward(from: 0);
  }

  @override
  Widget build(BuildContext context) {
    return IconButton(
      tooltip: widget.liked ? 'Unlike post' : 'Like post',
      onPressed: _like,
      icon: AnimatedBuilder(
        animation: _controller,
        builder: (context, child) {
          final progress = _controller.value;
          return Transform.scale(
            scale: _pop.value,
            child: SizedBox(
              width: 34,
              height: 34,
              child: Stack(
                alignment: Alignment.center,
                children: [
                  Icon(
                    Icons.favorite_border_rounded,
                    size: 29,
                    color: widget.liked ? Colors.redAccent : ink,
                  ),
                  if (widget.liked)
                    ClipRect(
                      child: Align(
                        alignment: Alignment.bottomCenter,
                        heightFactor: progress,
                        child: const Icon(
                          Icons.favorite_rounded,
                          size: 29,
                          color: Colors.redAccent,
                        ),
                      ),
                    ),
                ],
              ),
            ),
          );
        },
      ),
    );
  }
}

class _AnimatedFollowButton extends StatefulWidget {
  const _AnimatedFollowButton();

  @override
  State<_AnimatedFollowButton> createState() => _AnimatedFollowButtonState();
}

class _AnimatedFollowButtonState extends State<_AnimatedFollowButton>
    with SingleTickerProviderStateMixin {
  late final AnimationController _controller = AnimationController(
    vsync: this,
    duration: const Duration(milliseconds: 280),
  );

  bool _following = false;

  void _toggleFollow() {
    setState(() => _following = !_following);
    _controller.forward(from: 0);
  }

  @override
  void dispose() {
    _controller.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    return AnimatedBuilder(
      animation: _controller,
      builder: (context, child) => Transform.scale(
        scale: 1 + (0.09 * (1 - (_controller.value * 2 - 1).abs())),
        child: child,
      ),
      child: GestureDetector(
        onTap: _toggleFollow,
        child: AnimatedContainer(
          duration: const Duration(milliseconds: 220),
          padding: const EdgeInsets.symmetric(horizontal: 13, vertical: 7),
          decoration: BoxDecoration(
            color: _following ? const Color(0xFFF3F3F3) : Colors.white,
            borderRadius: BorderRadius.circular(9),
            border: Border.all(
              color: _following
                  ? const Color(0xFFE2E2E2)
                  : const Color(0xFFFF4F9A),
            ),
          ),
          child: _following
              ? const Text(
                  'Following',
                  style: TextStyle(
                    color: Color(0xFF555555),
                    fontSize: 12,
                    fontWeight: FontWeight.w700,
                  ),
                )
              : const ShaderMask(
                  shaderCallback: _pinkGradient,
                  child: Text(
                    'Follow',
                    style: TextStyle(
                      color: Colors.white,
                      fontSize: 12,
                      fontWeight: FontWeight.w800,
                    ),
                  ),
                ),
        ),
      ),
    );
  }

  static Shader _pinkGradient(Rect bounds) {
    return const LinearGradient(
      colors: [Color(0xFFFF4F9A), Color(0xFFFF2D55), Color(0xFFC135E8)],
    ).createShader(bounds);
  }
}

